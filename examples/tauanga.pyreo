# Tauanga — Counting in te reo Māori

tau_maori = ["tahi", "rua", "toru", "whā", "rima", "ono", "whitu", "waru", "iwa", "tekau"]

tā("Tatau mai tahi ki tekau:")
mō i i tūemi(roa(tau_maori)):
    tā(f"  {i + 1} = {tau_maori[i]}")

tā()

# Tapeke — Sum
tau_rārangi = [3, 7, 2, 9, 1]
tapeke_hua = tapeke(tau_rārangi)
tōrahi_hua = tōrahi(tau_rārangi)
tōiti_hua = tōiti(tau_rārangi)

tā(f"Rārangi: {tau_rārangi}")
tā(f"Tapeke: {tapeke_hua}")
tā(f"Tōrahi: {tōrahi_hua}")
tā(f"Tōiti: {tōiti_hua}")
